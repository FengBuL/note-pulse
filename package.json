{
  "name": "note-pulse",
  "version": "1.5.1",
  "description": "A dashboard for your vault: note and word trends, writing streak heatmap, task completion, tags and link stats.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node tests/run.mjs",
    "lint": "eslint src",
    "check:css": "node scripts/check-css.cjs styles.css",
    "sample:report": "node scripts/sample-report.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dashboard",
    "statistics"
  ],
  "author": "FengBuL",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "doiuse": "^6.0.6",
    "esbuild": "^0.23.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "postcss": "^8.5.29",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FengBuL/note-pulse.git"
  }
}
